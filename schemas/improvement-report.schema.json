    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "validator_id": {
      "title": "Validator Id",
      "type": "string"
    },
    "validity_region": {
      "default": [],
      "items": {
        "type": "string"
